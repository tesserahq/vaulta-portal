    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-router": "^7.13.0",
    "react-router-dom": "^7.18.4",
    "remix-i18next": "^7.0.0",
    "remix-utils": "9.3.1",
