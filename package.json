    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^15.4.0",
    "react-router": "^7.13.0",
    "react-router-dom": "^7.11.0",
    "remix-i18next": "^6.4.1",
    "remix-utils": "7.7.0",
    "shiki": "^3.4.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.0",
    "tessera-ui": "git+https://github.com/tesserahq/tessera-ui.git",
